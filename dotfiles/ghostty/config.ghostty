# Tuned for the 3840x2400 eDP-1 panel at Mango scale 1.6.
# The 2400x1500 logical screen targets the same 160x50 grid as Foot.
font-family = "CaskaydiaCove Nerd Font"
font-style = SemiBold
font-size = 17
adjust-cell-height = -6
adjust-cell-width = 4%

window-padding-x = 0
window-padding-y = 0
window-padding-balance = false
window-decoration = none

background-opacity = 0.85

scrollbar = never
confirm-close-surface = false
resize-overlay = never
command = /home/r/.config/tmux/foot-tmux.sh

window-show-tab-bar = never
gtk-tabs-location = bottom
gtk-toolbar-style = flat
gtk-wide-tabs = false
keybind = ctrl+shift+w=unbind
keybind = ctrl+shift+t=unbind
# Warning: This removes ALL default keybindings, including copy, paste, and split windows
#keybind = clear
